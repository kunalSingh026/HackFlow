# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/hackflow

# JWT Secrets (Generate random long strings)
JWT_SECRET=your-random-jwt-secret-string
JWT_REFRESH_SECRET=your-random-jwt-refresh-secret-string

# Nodemailer SMTP Configuration (Gmail recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Cloudinary Credentials (For image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Server Environment
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Sentry DSN (Optional)
SENTRY_DSN=
