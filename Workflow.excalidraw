    {
      "id": "9MMlVTOrsyWiLYAxw1oM5",
      "type": "text",
      "x": 1116.7264696043846,
      "y": 9436.509261696176,
      "width": 726.1795654296875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 1150307217,
      "version": 1871,
      "versionNonce": 1335776145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780735786102,
      "link": null,
      "locked": false,
      "text": "Now Let's add some Logic to the program like any event registration \ndate can't be after event's registration deadline like Event registration\ndate is on 20th April and the registration deadline is on 17th April this \nis not possible so let's lock this few things to make the things easy for\nthe organizers. Right now if a event is someone host a event and \ncreating new event they have to face lot's of problem and it's lot of \ntime consuming this will make the user frustrated if user selects the \nregistration date for the events is starting from 17th April then when \nthey go to add the registration deadline for that same event then why \nthey have see the options before the registration starting date. \nDates Before that should automatically get blocked same goes for the \ntime also if event is starting at 10AM on 17th April then why the \norganizer should get the time to select before 10AM of that same day\nfor judging round.\nSo, our task it to add some logics in those parts to makes the things\neasy for the event organizer and this will also reduce the amount of time \nuser take to register the event now and after this. \n\nNow let's create the logic to automatically remove the events from the\nlist.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now Let's add some Logic to the program like any event registration \ndate can't be after event's registration deadline like Event registration\ndate is on 20th April and the registration deadline is on 17th April this \nis not possible so let's lock this few things to make the things easy for\nthe organizers. Right now if a event is someone host a event and \ncreating new event they have to face lot's of problem and it's lot of \ntime consuming this will make the user frustrated if user selects the \nregistration date for the events is starting from 17th April then when \nthey go to add the registration deadline for that same event then why \nthey have see the options before the registration starting date. \nDates Before that should automatically get blocked same goes for the \ntime also if event is starting at 10AM on 17th April then why the \norganizer should get the time to select before 10AM of that same day\nfor judging round.\nSo, our task it to add some logics in those parts to makes the things\neasy for the event organizer and this will also reduce the amount of time \nuser take to register the event now and after this. \n\nNow let's create the logic to automatically remove the events from the\nlist.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "ellipse",
      "version": 2140,
