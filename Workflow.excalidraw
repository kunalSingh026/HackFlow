    {
      "id": "nGbt80LVqjVuvoYKGBvS3",
      "type": "text",
      "x": 599.1051984765598,
      "y": 4888.9300789029385,
      "width": 550.3104858398438,
      "height": 527.4145341612801,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 551079054,
      "version": 576,
      "versionNonce": 110830418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779078771905,
      "link": null,
      "locked": false,
      "text": "Team Name\n\nEvent\n\nLeader\n\nMembers\n\nJoin Code\n\nProject Detial (Future Proofing)\n\nSomeone can send the Request also to \njoin the team (Team Leader get's the option \nweather to approve the request or not.\n\n",
      "fontSize": 24.81950748994259,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Team Name\n\nEvent\n\nLeader\n\nMembers\n\nJoin Code\n\nProject Detial (Future Proofing)\n\nSomeone can send the Request also to \njoin the team (Team Leader get's the option \nweather to approve the request or not.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2Bycm8mfsR-Hcm1QZycn7",
      "type": "text",
      "x": 628.0060087335667,
      "y": 5845.168039906595,
      "width": 671.9716796875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1125304637,
      "version": 337,
      "versionNonce": 1813577299,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779095955531,
      "link": null,
      "locked": false,
      "text": "List of the Features that are completed till now.\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List of the Features that are completed till now.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9uGp4g5E0sdRb2h6Y0B8z",
      "type": "text",
      "x": 656.042230526778,
      "y": 5902.336020066707,
      "width": 642.65576171875,
      "height": 910,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 951279763,
      "version": 1392,
      "versionNonce": 698286381,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780633791743,
      "link": null,
      "locked": false,
      "text": "1. User Registration\n2. Email Verification\n3. Login\n4. Update Profile (add bio / profile picture)\n5. Create Event\n6. Register in the Event\n7. Get the Event Registration \n Tickets on the Email.\n8. Create a Team\n9. Send the Request to any Team\n Captian\n10. Captain will aprrove the request.\n11. Captian will recieve the notification\n if someone send a request to join their\n team.\n12. Once captain approve the request the\n You're in mail send to the user who\n send the request.\n13. Captain can get the list of the users \nthose who are registered for the event \nbut still not in any team.\n14. Captain can find the participants that \nare still not in the team and send them the \nteam invite.\n15. User will recieve the Team Invitation link \nand then they can Join the Team if they want.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User Registration\n2. Email Verification\n3. Login\n4. Update Profile (add bio / profile picture)\n5. Create Event\n6. Register in the Event\n7. Get the Event Registration \n Tickets on the Email.\n8. Create a Team\n9. Send the Request to any Team\n Captian\n10. Captain will aprrove the request.\n11. Captian will recieve the notification\n if someone send a request to join their\n team.\n12. Once captain approve the request the\n You're in mail send to the user who\n send the request.\n13. Captain can get the list of the users \nthose who are registered for the event \nbut still not in any team.\n14. Captain can find the participants that \nare still not in the team and send them the \nteam invite.\n15. User will recieve the Team Invitation link \nand then they can Join the Team if they want.",
      "autoResize": true,
      "lineHeight": 1.25
    },
